From 81a9609a48c87cdf15f65fbd9a15403a495ef81c Mon Sep 17 00:00:00 2001
From: Karsten Sperling <ksperling@apple.com>
Date: Fri, 26 Jun 2026 14:57:31 +1200
Subject: [PATCH] mbedtls: Accept standard IANA TLS 1.3 ciphersuite names

The openssl_ciphers parser matches individual cipher names by translating each
mbedtls name forward into OpenSSL style and comparing. This works for legacy
(TLS <=1.2) names, but not for the TLS 1.3 names where OpenSSL follows the IANA
naming convention. As a result, TLS 1.3 suites could only be selected by
non-standard names like "TLS-AES128-GCM-SHA256".

Add exact-match logic to recognize the five standardized TLS 1.3 suites (RFC
8446), e.g. "TLS_AES_128_GCM_SHA256". This makes these names work consistently
across all hostap SSL backends. (The non-standard names derived by the existing
translation logic continue to work.)

Signed-off-by: Karsten Sperling <ksperling@apple.com>
---
 src/crypto/tls_mbedtls.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/crypto/tls_mbedtls.c b/src/crypto/tls_mbedtls.c
index 6c766bcf2..65beeee3f 100644
--- a/src/crypto/tls_mbedtls.c
+++ b/src/crypto/tls_mbedtls.c
@@ -1225,6 +1225,37 @@ tls_mbedtls_set_ciphers(struct tls_conf *tls_conf, const char *ciphers)
         if (clen == 7 && os_memcmp(ciphers, "-aECDSA", 7) == 0)
             continue;
 
+        /* special-case the standardized TLS 1.3 ciphersuites by their IANA /
+         * OpenSSL names (e.g. "TLS_AES_128_GCM_SHA256"), because
+         * tls_mbedtls_translate_ciphername() below produces non-standard names
+         * for these (e.g. "TLS-AES128-GCM-SHA256" from the mbedtls name
+         * "TLS1-3-AES-128-GCM-SHA256"). This ensures the standard names work
+         * consistently across all backends. */
+        if (clen > 4 && os_memcmp(ciphers, "TLS_", 4) == 0) {
+            static const struct { const char *name; int id; } tls13_suites[] = {
+                { "TLS_AES_128_GCM_SHA256",       MBEDTLS_TLS1_3_AES_128_GCM_SHA256 },
+                { "TLS_AES_256_GCM_SHA384",       MBEDTLS_TLS1_3_AES_256_GCM_SHA384 },
+                { "TLS_CHACHA20_POLY1305_SHA256", MBEDTLS_TLS1_3_CHACHA20_POLY1305_SHA256 },
+                { "TLS_AES_128_CCM_SHA256",       MBEDTLS_TLS1_3_AES_128_CCM_SHA256 },
+                { "TLS_AES_128_CCM_8_SHA256",     MBEDTLS_TLS1_3_AES_128_CCM_8_SHA256 },
+            };
+            int tls13 = 0;
+            size_t k;
+            for (k = 0; k < ARRAY_SIZE(tls13_suites); ++k) {
+                if (clen == os_strlen(tls13_suites[k].name)
+                    && os_memcmp(ciphers, tls13_suites[k].name, clen) == 0) {
+                    nids = tls_mbedtls_append_ciphersuite(
+                             ids, nids, idsz, &tls13_suites[k].id, 1);
+                    if (nids == -1)
+                        return 0;
+                    tls13 = 1;
+                    break;
+                }
+            }
+            if (tls13)
+                continue;
+        }
+
         /* attempt to match mbedtls cipher names
          * nb: does not support openssl group names or list manipulation syntax
          *   (alt: could copy almost 1200 lines (!!!) of lighttpd mod_mbedtls.c
