+# EAP-TLS client-certificate pinning
+# Authorize EAP-TLS clients by matching the SHA-256 of their leaf certificate
+# against an allow-list.
+# 0 = disabled (default)
+# 1 = pin in addition to standard CA path validation
+# 2 = pin only, skip chain validation. No ca_cert is required in this mode.
+# Each allowed client is represented by an eap_user_file entry with an
+# identifier based on the SHA256 hash of the DER representation of the client's
+# certificate in the form
+#   "cert-sha256-<64 lower-case hex digits>"
+# Compute the hash with, e.g.:
+#   openssl x509 -in client.pem -outform DER | openssl dgst -sha256
+# Note that wildcard entries (e.g. "cert-*") are not accepted for this purpose.
+# When pinning is enabled, it supersedes check_cert_subject and cert-<serial>
+# user lookups: only the cert-sha256-<hash> user entry is used.
+# If TLS session resumption is enabled (tls_session_lifetime > 0), removing an
+# entry from the user file does not invalidate matching cached sessions.
+#eap_tls_cert_pinning=0
+
 # Maximum number of EAP message rounds with data (default: 100)
 #max_auth_rounds=100
 
