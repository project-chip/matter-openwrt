+def cert_sha256_pin(cert_pem):
+    """Return the "cert-sha256-<hex>" allow-list identity for a PEM cert."""
+    der = subprocess.check_output(["openssl", "x509", "-in", cert_pem,
+                                   "-outform", "DER"])
+    return "cert-sha256-" + hashlib.sha256(der).hexdigest()
+
+
+def gen_self_signed_client(workdir, name):
+    """Generate a self-signed EC client certificate (no committed equivalent)."""
+    key = os.path.join(workdir, name + ".key")
+    cert = os.path.join(workdir, name + ".pem")
+    run_openssl(["openssl", "req", "-x509", "-newkey", "ec",
+                 "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
+                 "-keyout", key, "-out", cert, "-days", "1",
+                 "-subj", "/CN=" + name])
+    if not os.path.exists(cert) or not os.path.exists(key):
+        raise HwsimSkip("Could not generate self-signed client certificate")
+    return cert, key
+
+
+def write_eap_user_file(workdir, name, entries):
+    """Write an eap_user file with the given identities all allowed to use TLS.
+
+    Callers pass a specific phase-1 identity plus any "cert-sha256-<hex>" pin
+    entries. A "*" wildcard is intentionally not used for method selection so
+    the pin lookup exercises an explicit entry.
+    """
+    path = os.path.join(workdir, name)
+    with open(path, "w") as f:
+        for ident in entries:
+            f.write('"%s"\tTLS\n' % ident)
+    return path
+
+
+def pinning_params(eap_user_file, mode, ssid="test-wpa2-eap"):
+    """Server params reusing the committed auth_serv PKI, with pinning enabled."""
+    params = int_eap_server_params()
+    params["ssid"] = ssid
+    params["eap_user_file"] = eap_user_file
+    params["eap_tls_cert_pinning"] = str(mode)
+    if mode == 2:
+        # Pin-only skips client trust-chain validation, so no CA is needed.
+        # Running without ca_cert also verifies hostapd does not require one
+        # for EAP-TLS in this mode.
+        del params["ca_cert"]
+    return params
+
+
+def test_ap_eap_tls_cert_pin_ok(dev, apdev, params):
+    """EAP-TLS pin-only: self-signed client on the allow-list authenticates"""
+    check_eap_capa(dev[0], "TLS")
+    cert, key = gen_self_signed_client(params['logdir'], "pin-ok-client")
+    eap_user = write_eap_user_file(params['logdir'], "pin-ok.eap_user",
+                                   ["pinned-client", cert_sha256_pin(cert)])
+    hapd = hostapd.add_ap(apdev[0], pinning_params(eap_user, 2))
+    eap_connect(dev[0], hapd, "TLS", "pinned-client",
+                ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key)
+
+
+def test_ap_eap_tls_cert_pin_not_listed(dev, apdev, params):
+    """EAP-TLS pin-only: self-signed client not on the allow-list is rejected"""
+    check_eap_capa(dev[0], "TLS")
+    cert, key = gen_self_signed_client(params['logdir'], "pin-nl-client")
+    other, _ = gen_self_signed_client(params['logdir'], "pin-nl-other")
+    # Allow-list contains a *different* certificate's pin only.
+    eap_user = write_eap_user_file(params['logdir'], "pin-nl.eap_user",
+                                   ["pinned-client", cert_sha256_pin(other)])
+    hapd = hostapd.add_ap(apdev[0], pinning_params(eap_user, 2))
+    eap_connect(dev[0], hapd, "TLS", "pinned-client", expect_failure=True,
+                ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key)
+
+
+def test_ap_eap_tls_cert_pin_empty_list(dev, apdev, params):
+    """EAP-TLS pin-only: empty allow-list fails closed"""
+    check_eap_capa(dev[0], "TLS")
+    cert, key = gen_self_signed_client(params['logdir'], "pin-empty-client")
+    eap_user = write_eap_user_file(params['logdir'], "pin-empty.eap_user",
+                                   ["pinned-client"])
+    hapd = hostapd.add_ap(apdev[0], pinning_params(eap_user, 2))
+    eap_connect(dev[0], hapd, "TLS", "pinned-client", expect_failure=True,
+                ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key)
+
+
+def test_ap_eap_tls_cert_pin_wildcard(dev, apdev, params):
+    """EAP-TLS pin-only: a wildcard eap_user entry does not authorize a pin"""
+    check_eap_capa(dev[0], "TLS")
+    cert, key = gen_self_signed_client(params['logdir'], "pin-wild-client")
+    # A catch-all "*" entry (as many deployments have for method selection)
+    # must not satisfy the exact "cert-sha256-<hex>" pin lookup.
+    path = os.path.join(params['logdir'], "pin-wild.eap_user")
+    with open(path, "w") as f:
+        f.write("*\tTLS\n")
+    hapd = hostapd.add_ap(apdev[0], pinning_params(path, 2))
+    eap_connect(dev[0], hapd, "TLS", "anyone", expect_failure=True,
+                ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key)
+
+
+def test_ap_eap_tls_cert_pin_no_client_cert(dev, apdev, params):
+    """EAP-TLS pin-only: a client presenting no certificate is rejected"""
+    check_eap_capa(dev[0], "TLS")
+    eap_user = write_eap_user_file(params['logdir'], "pin-nocert.eap_user",
+                                   ["pinned-client"])
+    hapd = hostapd.add_ap(apdev[0], pinning_params(eap_user, 2))
+    # Normally wpa_supplicant will refuse to attempt EAP-TLS without a
+    # certificate, force via CONFIG_TESTING_OPTIONS / tls_no_client_cert=1.
+    eap_connect(dev[0], hapd, "TLS", "pinned-client", expect_failure=True,
+                ca_cert="auth_serv/ca.pem",
+                phase1="tls_no_client_cert=1")
+
+
+def test_ap_eap_tls_cert_pin_with_ca(dev, apdev, params):
+    """EAP-TLS pin+CA: a CA-signed client also needs an allow-list entry"""
+    check_eap_capa(dev[0], "TLS")
+    # auth_serv/user.pem is signed by auth_serv/ca.pem (the trusted PKI).
+    pin = cert_sha256_pin("auth_serv/user.pem")
+
+    # With the pin present: full chain validation AND the allow-list pass.
+    eap_user = write_eap_user_file(params['logdir'], "pin-withca.eap_user",
+                                   ["tls user", pin])
+    hapd = hostapd.add_ap(apdev[0], pinning_params(eap_user, 1))
+    eap_connect(dev[0], hapd, "TLS", "tls user",
+                ca_cert="auth_serv/ca.pem",
+                client_cert="auth_serv/user.pem",
+                private_key="auth_serv/user.key")
+
+    # Without the pin: a valid CA chain is no longer sufficient. Use a second
+    # BSS with the same SSID and pin the association by BSSID.
+    eap_user2 = write_eap_user_file(params['logdir'], "pin-withca-none.eap_user",
+                                    ["tls user"])
+    hapd2 = hostapd.add_ap(apdev[1], pinning_params(eap_user2, 1))
+    eap_connect(dev[1], hapd2, "TLS", "tls user", expect_failure=True,
+                bssid=apdev[1]['bssid'],
+                ca_cert="auth_serv/ca.pem",
+                client_cert="auth_serv/user.pem",
+                private_key="auth_serv/user.key")
+
+
+def test_ap_eap_tls_cert_pin_radius(dev, apdev, params):
+    """EAP-TLS pin-only enforced by an integrated RADIUS server"""
+    check_eap_capa(dev[0], "TLS")
+    workdir = params['logdir']
+    cert, key = gen_self_signed_client(workdir, "pin-radius-ok")
+    other, other_key = gen_self_signed_client(workdir, "pin-radius-bad")
+    eap_user = write_eap_user_file(workdir, "pin-radius.eap_user",
+                                   ["pinned-client", cert_sha256_pin(cert)])
+
+    # A hostapd instance acting as the RADIUS server terminates EAP-TLS and
+    # applies pinning. No ca_cert is needed since pin-only skips client
+    # trust-chain validation.
+    as_params = {"ssid": "as", "beacon_int": "2000",
+                 "radius_server_clients": "auth_serv/radius_clients.conf",
+                 "radius_server_auth_port": "18128",
+                 "eap_server": "1",
+                 "eap_user_file": eap_user,
+                 "server_cert": "auth_serv/server.pem",
+                 "private_key": "auth_serv/server.key",
+                 "eap_tls_cert_pinning": "2"}
+    hostapd.add_ap(apdev[1], as_params)
+
+    params2 = hostapd.wpa2_eap_params(ssid="test-wpa2-eap")
+    params2["auth_server_port"] = "18128"
+    hapd = hostapd.add_ap(apdev[0], params2)
+
+    # On the allow-list -> authenticates through the RADIUS server.
+    eap_connect(dev[0], hapd, "TLS", "pinned-client", ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key)
+    # Not on the allow-list -> rejected on the same RADIUS-terminated path.
+    eap_connect(dev[1], hapd, "TLS", "pinned-client", expect_failure=True,
+                ca_cert="auth_serv/ca.pem",
+                client_cert=other, private_key=other_key)
+
+
+def test_ap_eap_tls_cert_pin_resumption(dev, apdev, params):
+    """EAP-TLSv1.3 pin-only: a resumed session skips the allow-list re-check"""
+    check_eap_capa(dev[0], "TLS")
+    check_tls13_support(dev[0])
+    cert, key = gen_self_signed_client(params['logdir'], "pin-resume-client")
+    eap_user = write_eap_user_file(params['logdir'], "pin-resume.eap_user",
+                                   ["pinned-client", cert_sha256_pin(cert)])
+    hparams = pinning_params(eap_user, 2)
+    # TLS 1.2 resumption does not re-enter the post-handshake pinning check, so
+    # force TLS 1.3 where the resumed handshake does reach it (with no peer
+    # certificate exchanged).
+    hparams["tls_flags"] = "[ENABLE-TLSv1.3]"
+    hparams["tls_session_lifetime"] = "60"
+    hapd = hostapd.add_ap(apdev[0], hparams)
+    check_tls13_support(hapd)
+    check_tls_session_resumption_capa(dev[0], hapd)
+
+    phase1 = "tls_disable_tlsv1_0=1 tls_disable_tlsv1_1=1 tls_disable_tlsv1_2=1 tls_disable_tlsv1_3=0"
+    eap_connect(dev[0], hapd, "TLS", "pinned-client",
+                ca_cert="auth_serv/ca.pem",
+                client_cert=cert, private_key=key, phase1=phase1)
+    if dev[0].get_status_field("eap_tls_version") != "TLSv1.3":
+        raise Exception("Unexpected TLS version on the first connection")
+    if dev[0].get_status_field("tls_session_reused") != '0':
+        raise Exception("Unexpected session resumption on the first connection")
+
+    # Reauthenticate: the resumed handshake exchanges no client certificate, so
+    # the pinning check must be skipped rather than failing closed (the session
+    # only became resumable after the initial full handshake passed the check).
+    dev[0].request("REAUTHENTICATE")
+    ev = dev[0].wait_event(["CTRL-EVENT-EAP-SUCCESS"], timeout=10)
+    if ev is None:
+        raise Exception("EAP success timed out")
+    ev = dev[0].wait_event(["WPA: Key negotiation completed"], timeout=10)
+    if ev is None:
+        raise Exception("Key handshake with the AP timed out")
+    if dev[0].get_status_field("tls_session_reused") != '1':
+        raise Exception("Session resumption not used on the second connection")
