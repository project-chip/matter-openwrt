+#ifdef CONFIG_EAP_TLS_PINNING
+static int eap_tls_authorize_client_cert(struct eap_sm *sm,
+					 struct eap_tls_data *data)
+{
+	struct wpabuf *cert;
+	const u8 *addr[1];
+	size_t len[1];
+	u8 hash[SHA256_MAC_LEN];
+	char id[sizeof("cert-sha256-") + 2 * SHA256_MAC_LEN];
+	int id_len;
+
+	cert = tls_connection_get_peer_cert(data->ssl.conn);
+	if (!cert) {
+		wpa_printf(MSG_DEBUG,
+			   "EAP-TLS: Could not fetch peer certificate for pinning");
+		return -1;
+	}
+
+	addr[0] = wpabuf_head(cert);
+	len[0] = wpabuf_len(cert);
+	if (sha256_vector(1, addr, len, hash) < 0) {
+		wpabuf_free(cert);
+		return -1;
+	}
+	wpabuf_free(cert);
+
+	id_len = os_snprintf(id, sizeof(id), "cert-sha256-");
+	if (os_snprintf_error(sizeof(id), id_len))
+		return -1;
+	id_len += wpa_snprintf_hex(id + id_len, sizeof(id) - id_len,
+				   hash, sizeof(hash));
+
+	/* Require an exact match so that a wildcard ("*") method-selection
+	 * entry does not authorize an arbitrary certificate. */
+	if (eap_user_get(sm, (const u8 *) id, id_len, data->phase2) != 0 ||
+	    !sm->user || !sm->user->exact_match) {
+		wpa_printf(MSG_INFO,
+			   "EAP-TLS: Client certificate %s not in allow-list",
+			   id);
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "EAP-TLS: Client certificate %s authorized", id);
+	return 0;
+}
+#endif /* CONFIG_EAP_TLS_PINNING */
