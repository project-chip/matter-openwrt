{
    "user": "matter",
    "access": {
        "otbr": {
            "methods": ["*"]
        },
        "uci": {
            "methods": [
                "get",
                "set",
                "commit"
            ]
        },
        "service": {
            "methods": [
                "list"
            ]
        }
    },
    "publish": [ "matter" ],
    "subscribe": [ "otbr", "uci", "service" ],
    "listen": [ "ubus.object.*", "uci", "network.interface" ]
}
