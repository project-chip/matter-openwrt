-constexpr uint16_t kOptionWifiIface   = 0x1002;
-constexpr uint16_t kOptionNoWifiShare = 0x1003;
-constexpr uint16_t kOptionNoThread    = 0x1004;
+constexpr uint16_t kOptionWifiNetwork  = 0x1001;
+constexpr uint16_t kOptionWifiIface    = 0x1002;
+constexpr uint16_t kOptionNoWifiShare  = 0x1003;
+constexpr uint16_t kOptionNoThread     = 0x1004;
