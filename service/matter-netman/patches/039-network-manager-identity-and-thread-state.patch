         return true;
@@ -118,6 +122,7 @@ ArgParser::OptionDef sAppOptionDefs[] = {
     { "no-thread", ArgParser::kNoArgument, kOptionNoThread },
     { "primary-interface", ArgParser::kArgumentRequired, kOptionPrimaryIface },
