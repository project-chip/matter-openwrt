+
     // Nullable attributes without a ubus source.
     case Attributes::PendingTimestamp::Id:
     case Attributes::Delay::Id:
-    case Attributes::SecurityPolicy::Id:
-    case Attributes::ChannelPage0Mask::Id:
     case Attributes::ExtAddress::Id:
